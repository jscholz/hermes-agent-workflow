[Unit]
Description=Hermes Agent web dashboard (config, keys, sessions)
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# HERMES_DASHBOARD_HOST is read from ~/.hermes/.env (bootstrap writes
# 127.0.0.1). To bind a tailnet FQDN instead you must ALSO configure an
# auth provider (HERMES_DASHBOARD_BASIC_AUTH_USERNAME / _PASSWORD_HASH /
# _SECRET) — current hermes refuses a non-loopback bind without one.
EnvironmentFile=%h/.hermes/.env
# Loopback by default. Current hermes ALWAYS requires an auth provider on
# a non-loopback bind (--insecure no longer bypasses it), so a tailnet host
# here without HERMES_DASHBOARD_BASIC_AUTH_* crash-loops the unit. Reach
# the dashboard over the tailnet via Tailscale Serve (bootstrap sets it up).
ExecStart=/bin/sh -c '%h/.local/bin/hermes dashboard --host ${HERMES_DASHBOARD_HOST:-127.0.0.1} --port 9119 --no-open --insecure'
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Keep Hermes' startup skill sync from rewriting the workflow checkout.
Environment=HERMES_BUNDLED_SKILLS=%h/.hermes/skills
# No HERMES_WEB_DIST override. Current hermes does not ship a prebuilt
# web_dist in the source tree; with the override pointing at that path the
# dashboard refused to start ("HERMES_WEB_DIST is set but no web dist
# found") and crash-looped on a virgin install (2026-11-10). Unset, hermes
# locates or builds its default UI itself.

[Install]
WantedBy=default.target
