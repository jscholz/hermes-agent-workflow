[Unit]
Description=Hermes Agent gateway (API server + messaging platform adapters)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# `run` is the foreground/systemd-friendly variant (vs `start` which expects
# an already-installed service). API server reads API_SERVER_* from
# ~/.hermes/.env; platform adapters (telegram, etc.) read their tokens same place.
ExecStart=%h/.local/bin/hermes gateway run
Restart=on-failure
RestartSec=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Auto-approve unseen shell hooks so the service doesn't hang waiting for a
# TTY prompt. Equivalent to --accept-hooks / hooks_auto_accept: true.
Environment=HERMES_ACCEPT_HOOKS=1
# The workflow owns ~/.hermes/skills as a versioned symlink into the
# instance repo. Upstream Hermes syncs bundled skills on gateway start;
# point the bundled source at the same tree so service startup does not
# rewrite the checkout just because upstream Hermes moved.
Environment=HERMES_BUNDLED_SKILLS=%h/.hermes/skills
# Parley is integrated through the Hermes plugin shipped in the
# parley repo. Keep plugin/proxy ownership flags in sync.
Environment=PARLEY_PUSH_OWNED_BY_PLUGIN=true
Environment=PARLEY_INFLIGHT_OWNED_BY_PLUGIN=true

[Install]
WantedBy=default.target
