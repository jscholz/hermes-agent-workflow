# Secrets — only commit through git-crypt (see .gitattributes for the
# encryption patterns). The negations below allow specific encrypted
# files past the defensive globs.
.env
.env.*
*.env
# allow .env back in (encrypted via git-crypt)
!.env

# Defensive: block anything that smells like a credential UNLESS we've
# explicitly opted it in to the encryption pipeline.
*token*
*credentials*
*secret*
# allow these specific encrypted secrets back in
!auth.json
!google_token.json
!google_client_secret.json
!gogcli/
!gogcli/**
# legitimate examples / placeholders stay tracked
!*.example
!example.config.yaml

# SQLite — live DBs, never version
*.db
*.db-shm
*.db-wal

# Log files — runtime, ever-growing, never version
*.log

# Runtime cache the gateway rebuilds every 5 min via atomic_json_write
# (which nukes any symlink at this path on every refresh). Has no
# archival value; keep it untracked.
channel_directory.json

# memory-tool lock files (transient, hermes-created)
memories/*.lock
cron/.tick.lock
skills/.curator_state

# Skill curator's local rollback snapshots — gzipped tarballs that defeat
# git pack-delta and duplicate git's own history. The curator self-prunes
# these on disk and restores from disk, never from git. Keep them untracked.
skills/.curator_backups/

# WhatsApp bridge runtime PID
whatsapp/session/bridge.pid

# Generated by bootstrap: points from the versioned plugins directory
# into the sibling parley checkout. Recreated on each host.
plugins/parley

# Editor/OS cruft
.DS_Store
*.swp
*~
scripts/__pycache__/
